# aikit defaults (committed). Put secrets in .env.secrets (ignored), never commit keys.
export AIKIT_BASE_URL="${AIKIT_BASE_URL:-https://api.openai.com/v1}"
export AIKIT_MODEL="${AIKIT_MODEL:-gpt-4o-mini}"
# Optional: default translation target (e.g. zh, en, ja). Unset means auto Chinese-English.
# Optional: default translation source language. Unset means auto-detect.
# Optional: language of generated commit messages (default English).
# export AIKIT_TR_TO="zh"
# export AIKIT_TR_FROM="en"
# export AIKIT_COMMIT_LANG="English"
if [ -f .env.secrets ]; then
  source_env .env.secrets
fi
