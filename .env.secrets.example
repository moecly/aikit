# Copy to .env.secrets and fill in your values. Never commit .env.secrets.
# cp .env.secrets.example .env.secrets

# API key for the OpenAI-compatible backend. Required.
export AIKIT_API_KEY="sk-..."

# Base URL of the OpenAI-compatible API. Uncomment to override the .envrc default.
# export AIKIT_BASE_URL="https://api.openai.com/v1"

# Default model for all subcommands. Uncomment to override the .envrc default.
# Can still be overridden per invocation with --model.
# export AIKIT_MODEL="gpt-4o-mini"

# Default translation target language (e.g. zh, en, ja).
# Unset means auto Chinese-English: CJK input -> English, otherwise -> Chinese.
# export AIKIT_TR_TO="zh"

# Default translation source language (e.g. zh, en, ja).
# Unset means auto-detect.
# export AIKIT_TR_FROM="en"

# Language of generated commit messages (default English).
# export AIKIT_COMMIT_LANG="English"
